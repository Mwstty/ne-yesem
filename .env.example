# Bu dosyayı ".env" adıyla kopyalayıp doldurun. .env GitHub'a gönderilmez.
# Anahtarlar boş bırakılırsa site DEMO MODU'nda çalışır.

# Google Cloud > "Places API (New)" etkin olmalı. Gerçek restoran verisi için.
GOOGLE_MAPS_API_KEY=

# Anthropic API anahtarı. Boşsa seçim kural tabanlı yapılır (AI yok).
AI_API_KEY=
AI_MODEL=claude-haiku-5-5

PORT=3000
